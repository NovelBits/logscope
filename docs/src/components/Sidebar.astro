---
import Default from '@astrojs/starlight/components/Sidebar.astro';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
// Go up from docs/src/components/ to the extension root
const pkg = JSON.parse(readFileSync(resolve(import.meta.dirname, '..', '..', '..', '..', 'package.json'), 'utf-8'));
---

<Default><slot /></Default>

<div class="sl-sidebar-footer">
  <a href="https://marketplace.visualstudio.com/items?itemName=novelbits.novelbits-logscope" class="sl-sidebar-footer-version" target="_blank" rel="noopener">LogScope v{pkg.version}</a>
  <div class="sl-sidebar-footer-links">
    <a href="https://github.com/NovelBits/logscope" target="_blank" rel="noopener">GitHub</a>
    <span class="sl-sidebar-footer-sep">&middot;</span>
    <a href="https://novelbits.io/logscope" target="_blank" rel="noopener">from Novel Bits</a>
  </div>
</div>

<style>
  .sl-sidebar-footer {
    padding: 0.75rem 1rem;
    border-top: 1px solid var(--sl-color-gray-6);
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .sl-sidebar-footer a {
    text-decoration: none;
    font-size: 0.75rem;
    transition: color 0.15s;
  }
  .sl-sidebar-footer-version {
    color: var(--sl-color-gray-2);
  }
  .sl-sidebar-footer-links {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .sl-sidebar-footer-links a {
    color: var(--sl-color-gray-3);
    font-size: 0.7rem !important;
  }
  .sl-sidebar-footer-sep {
    color: var(--sl-color-gray-4);
    font-size: 0.7rem;
  }
  .sl-sidebar-footer a:hover {
    color: var(--sl-color-accent-high);
  }
</style>
